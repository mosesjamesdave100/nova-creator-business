# Copy this file to .env.local and fill in your own Supabase project's values.
# Never commit .env or .env.local - they're already gitignored.
#
# Both values come from your Supabase project dashboard:
# Project Settings -> API
#
# VITE_SUPABASE_ANON_KEY is the public "anon" / "publishable" key - safe to
# ship in client-side code because Row Level Security (see supabase/schema.sql)
# is what actually restricts access, not secrecy of this key. NEVER put the
# "service_role" key here or anywhere in frontend code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
